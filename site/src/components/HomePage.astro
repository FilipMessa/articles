---
import Base from "../layouts/Base.astro";
import TopBar from "./TopBar.astro";
import Footer from "./Footer.astro";
import { ui, href, author, getArticles, formatDate, type Lang } from "../site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const articles = await getArticles(lang);
---

<Base lang={lang} title={author} description={t.description} alternate={href(lang === "en" ? "sk" : "en")}>
  <TopBar lang={lang} current="articles" alternate={href(lang === "en" ? "sk" : "en")} showMark={false} />
  <main id="main">
    <header class="home-head">
      <h1 class="wordmark">{author}</h1>
      <p>{t.intro}</p>
    </header>
    <section class="section" aria-labelledby="articles">
      <h2 class="section-title" id="articles">{t.articles}</h2>
      <ol class="index" reversed>
        {
          articles.map((a) => (
            <li>
              <a href={href(lang, a.slug)}>
                <div class="lead">
                  <h3>{a.title}</h3>
                  <p>{a.description}</p>
                </div>
                <div class="note">
                  <time datetime={a.date.toISOString().slice(0, 10)}>{formatDate(a.date, lang)}</time>
                  <span class="meta">{t.minRead(a.minutes)}</span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
