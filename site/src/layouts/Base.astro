---
import "../styles/global.css";
// Preload the fonts used above the fold so they arrive with the HTML instead of after the CSS.
import serifLatin from "../../node_modules/@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import serifLatinExt from "../../node_modules/@fontsource/instrument-serif/files/instrument-serif-latin-ext-400-normal.woff2?url";
import sansLatin from "../../node_modules/@fontsource-variable/instrument-sans/files/instrument-sans-latin-wdth-normal.woff2?url";
import sansLatinExt from "../../node_modules/@fontsource-variable/instrument-sans/files/instrument-sans-latin-ext-wdth-normal.woff2?url";
import { goatcounterCode, ui, type Lang } from "../site";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  alternate?: string;
  article?: { headline: string; date: string };
}
const { lang, title, description, alternate, article } = Astro.props;
const t = ui[lang];
const preloadFonts = [serifLatin, serifLatinExt, sansLatin, ...(lang === "sk" ? [sansLatinExt] : [])];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alternateUrl = alternate && new URL(alternate, Astro.site).href;
const articleData = article && JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.headline,
  description,
  datePublished: article.date,
  author: { "@type": "Person", name: "Filip Mešša", url: "https://github.com/FilipMessa" },
  mainEntityOfPage: canonical,
  inLanguage: lang,
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preloadFonts.map((font) => <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />)}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ebebeb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    {alternateUrl && <link rel="alternate" hreflang={lang} href={canonical} />}
    {alternateUrl && <link rel="alternate" hreflang={lang === "en" ? "sk" : "en"} href={alternateUrl} />}
    {goatcounterCode && import.meta.env.PROD && (
      <script
        is:inline
        async
        data-goatcounter={`https://${goatcounterCode}.goatcounter.com/count`}
        src="https://gc.zgo.at/count.js"
      />
    )}
    {articleData && <script type="application/ld+json" set:html={articleData} />}
  </head>
  <body>
    <slot />
  </body>
</html>
