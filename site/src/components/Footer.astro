---
import { ui, author, githubUrl, type Lang } from "../site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<footer class="footer">
  <nav class="footer-links" aria-label={t.elsewhere}>
    <a href={githubUrl}>GitHub</a>
  </nav>
  <span class="footer-copy">© 2026 {author}</span>
</footer>
